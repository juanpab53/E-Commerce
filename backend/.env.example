# --- Database (PostgreSQL / Supabase) ---
# Required by application.properties
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<database>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>

# --- JWT ---
JWT_SECRET_KEY=<base64-secret>   # e.g. openssl rand -base64 32
JWT_EXPIRATION=60                # token lifetime in minutes

# --- Stripe (Not implemented yet) ---
#STRIPE_SECRET_KEY=sk_test_...
#PAYMENTS_GATEWAY=local   # local (default) | stripe

# --- CORS (Not implemented yet) ---
#CORS_ALLOWED_ORIGINS=http://localhost:5173